# Server Configuration
PORT=8080

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=titipin
PGUSER=postgres
PGPASSWORD=your_password_here
DB_CONNECTION_TIMEOUT_MS=5000
HTTP_HOST=0.0.0.0
PGSSLMODE=disable

# Browser origins allowed to read API responses (comma separated).
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenID Connect
OIDC_ISSUER=
OIDC_JWKS_URI=
OIDC_AUDIENCE=
# Nilai realm lokal dari Step 3 (isi pada service/.env, bukan template):
# OIDC_ISSUER=http://localhost:8081/realms/titipin
# OIDC_JWKS_URI=http://localhost:8081/realms/titipin/protocol/openid-connect/certs
# OIDC_AUDIENCE=titipin-api
# Deployment wajib memakai issuer/JWKS HTTPS yang dapat dijangkau server.

# Structured application logs
LOG_LEVEL=info
