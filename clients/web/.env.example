# URL API Titipin tanpa slash di akhir. Untuk lokal gunakan service pada port 8080.
VITE_API_BASE_URL=http://localhost:8080/v1

# Realm Keycloak lokal dari infra/seed-auth.cjs.
VITE_OIDC_ISSUER=http://localhost:8081/realms/titipin
VITE_OIDC_CLIENT_ID=titipin-web
# Kosongkan saat lokal agar otomatis memakai origin aplikasi + /callback.
VITE_OIDC_REDIRECT_URI=

# Origin yang boleh memanggil API, dipisahkan koma. Variabel ini dipakai service.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
